#!/usr/bin/env zsh
set -euo pipefail

dry_run=false
if (( $# == 1 )) && [[ "$1" == "--dry-run" ]]; then
  dry_run=true
elif (( $# != 0 )); then
  echo "usage: scripts/justchill-ci [--dry-run]" >&2
  exit 64
fi

repo="${0:A:h:h}"
slug="emm3000/Just-Chill"
cd "$repo"

dirty="$(git status --porcelain --untracked-files=all)"
if [[ -n "$dirty" ]]; then
  echo "refusing to gate a dirty tree:" >&2
  printf '%s\n' "$dirty" >&2
  exit 1
fi

sha="$(git rev-parse HEAD)"
if [[ "$dry_run" == false ]] && ! lookup="$(gh api "repos/$slug/commits/$sha" --silent 2>&1)"; then
  if [[ "$lookup" == *"(HTTP 404)"* || "$lookup" == *"(HTTP 422)"* ]]; then
    echo "HEAD $sha is not on GitHub yet; push it first" >&2
  else
    echo "could not check HEAD $sha on GitHub: $lookup" >&2
  fi
  exit 1
fi

SECONDS=0
code=0
CI=true ./gradlew qualityGate assembleDevDebug || code=$?
gradle_duration=$SECONDS
echo "gate exit code: $code"

ios_code=0
ios_step() {
  local name="$1"
  shift
  local started=$SECONDS
  local step_code=0
  "$@" || step_code=$?
  echo "$name exit code: $step_code, $(( SECONDS - started ))s"
  if (( step_code != 0 )); then
    ios_code=$step_code
  fi
}

ios_step swift-format xcrun swift-format lint --strict -r iosApp
ios_step xcodebuild xcodebuild -project iosApp/JustChill.xcodeproj -scheme JustChill -destination 'generic/platform=iOS Simulator' build
ios_step token-drift scripts/ios-token-drift

ios_simulator=justchill-ios27
native_suites() {
  if ! xcrun simctl list devices booted -j \
    | jq -e --arg name "$ios_simulator" '[.devices[][] | select(.name == $name)] | length > 0' > /dev/null; then
    echo "$ios_simulator is not booted; run: xcrun simctl boot $ios_simulator" >&2
    return 1
  fi
  CI=true ./gradlew :core:database:iosSimulatorArm64Test :shared:iosSimulatorArm64Test
}
ios_step native-suites native_suites
duration=$SECONDS
echo "ios exit code: $ios_code, $(( duration - gradle_duration ))s"

state=success
if (( code != 0 || ios_code != 0 )); then
  state=failure
fi

payload="$(jq -n \
  --arg state "$state" \
  --arg description "${duration}s on $(hostname -s)" \
  '{state: $state, context: "local-gate", description: $description}')"

if [[ "$dry_run" == true ]]; then
  echo "POST repos/$slug/statuses/$sha"
  printf '%s\n' "$payload"
else
  gh api -X POST "repos/$slug/statuses/$sha" --input - --jq '"posted \(.context) \(.state) on \(.url)"' <<< "$payload"
fi

if (( code == 0 )); then
  code=$ios_code
fi
exit $code
