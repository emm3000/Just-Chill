#!/usr/bin/env bash
# Pre-push: run detekt over every source set that actually holds code.
#
# NOT `./gradlew detekt`. After the KMP migration that task is NO-SOURCE on
# :domain, :data and :shared-ui — it only ever linted :androidApp, which is now a
# thin entry point. See scripts/git-hooks/README.md.
#
# Fails the push on any new finding (one not in `config/detekt/baseline-*.xml`).
#
# Skip with: git push --no-verify

set -e

# Drain stdin (git feeds ref info — we don't use it but some shells trip without consuming).
cat > /dev/null

echo "→ detekt…"
./gradlew --quiet --console=plain \
    detektMainAndroid \
    detektIosMainSourceSet \
    :androidApp:detektMain \
    :shared-ui:detektAndroidHostTestSourceSet \
    :data:detektAndroidDeviceTestSourceSet
echo "✓ detekt clean"
