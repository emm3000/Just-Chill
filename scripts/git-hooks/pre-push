#!/usr/bin/env bash
# Pre-push: runs `./gradlew qualityGate` and fails the push on any finding.
# The gate is defined once, in build-logic/.../QualityGateConventionPlugin.kt — change it there.
# Skip with: git push --no-verify

set -e

# Drain stdin (git feeds ref info — we don't use it but some shells trip without consuming).
cat > /dev/null

echo "→ quality gate…"
./gradlew --quiet --console=plain qualityGate
echo "✓ quality gate clean"
