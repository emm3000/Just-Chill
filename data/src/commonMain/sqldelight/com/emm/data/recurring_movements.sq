-- A template is a movement that has not happened yet, so it carries the same invariant as the
-- movement it will produce: its category must be of its own type. Without it,
-- ConfirmRecurringMovementUseCase copies the template's categoryId onto a transaction of the
-- template's type — a mismatched template mints a mismatched movement every month, forever.
--
-- Same composite key, same NULL semantics, and the same reason for having no `ON DELETE` clause,
-- as `transactions`. The full reasoning lives in the header of transactions.sq; it is not repeated
-- here because it is one decision, not two.
CREATE TABLE recurring_movements (
    id                  TEXT NOT NULL PRIMARY KEY,
    name                TEXT NOT NULL,
    type                TEXT NOT NULL,
    amount              INTEGER,
    description         TEXT NOT NULL DEFAULT '',
    categoryId          TEXT,
    accountId           TEXT NOT NULL REFERENCES accounts(accountId) ON DELETE RESTRICT,
    frequency           TEXT NOT NULL DEFAULT 'Monthly',
    dayOfMonth          INTEGER NOT NULL,
    isActive            INTEGER NOT NULL DEFAULT 1,
    lastConfirmedPeriod TEXT,
    createdAt           INTEGER NOT NULL,
    updatedAt           INTEGER NOT NULL,
    userId              TEXT,
    deletedAt           INTEGER,
    syncState           TEXT NOT NULL DEFAULT 'Pending',
    FOREIGN KEY (categoryId, type) REFERENCES categories(categoryId, categoryType)
);

CREATE INDEX IF NOT EXISTS recurring_active_idx ON recurring_movements(isActive, name);
CREATE INDEX IF NOT EXISTS recurring_movements_syncstate_idx ON recurring_movements(syncState);
CREATE INDEX IF NOT EXISTS recurring_movements_user_deleted_idx ON recurring_movements(userId, deletedAt);

selectActive:
SELECT * FROM recurring_movements WHERE isActive = 1 AND deletedAt IS NULL ORDER BY name;

find:
SELECT * FROM recurring_movements WHERE id = ? AND deletedAt IS NULL;

insert:
INSERT INTO recurring_movements(id, name, type, amount, description, categoryId, accountId, frequency, dayOfMonth, isActive, lastConfirmedPeriod, createdAt, updatedAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Pending');

update:
UPDATE recurring_movements
SET name = ?, type = ?, amount = ?, description = ?, categoryId = ?, accountId = ?, dayOfMonth = ?, isActive = ?, updatedAt = ?, syncState = 'Pending'
WHERE id = ?;

softDelete:
UPDATE recurring_movements
SET deletedAt = ?, updatedAt = ?, syncState = 'Pending'
WHERE id = ?;

deleteAll:
DELETE FROM recurring_movements;

selectAllWithDetails:
SELECT
    rm.*,
    c.name  AS categoryName,
    c.color AS categoryColor,
    a.name  AS accountName
FROM recurring_movements rm
LEFT JOIN categories c ON rm.categoryId = c.categoryId AND c.deletedAt IS NULL
LEFT JOIN accounts   a ON rm.accountId  = a.accountId AND a.deletedAt IS NULL
WHERE rm.deletedAt IS NULL
ORDER BY rm.isActive DESC, rm.dayOfMonth, rm.name;

markConfirmed:
UPDATE recurring_movements
SET lastConfirmedPeriod = ?, updatedAt = ?, syncState = 'Pending'
WHERE id = ?;

countLiveByAccount:
SELECT COUNT(*) FROM recurring_movements WHERE accountId = :accountId AND deletedAt IS NULL;

claimAll:
UPDATE recurring_movements SET userId = :userId, syncState = 'Pending' WHERE userId IS NULL;

unclaimAll:
UPDATE recurring_movements SET userId = NULL, syncState = 'Pending' WHERE userId = :userId;

selectPending:
SELECT * FROM recurring_movements WHERE syncState = 'Pending' AND userId IS NOT NULL;

markSynced:
UPDATE recurring_movements SET syncState = 'Synced' WHERE id = ? AND updatedAt = ?;

markPendingForResync:
UPDATE recurring_movements SET syncState = 'Pending' WHERE id = ?;

-- See accounts.sq:accountSyncRevision for why syncState is selected and why the name is per-table.
recurringMovementSyncRevision:
SELECT updatedAt, syncState FROM recurring_movements WHERE id = ?;

insertOrIgnoreFromRemote:
INSERT OR IGNORE INTO recurring_movements(id, name, type, amount, description, categoryId, accountId, frequency, dayOfMonth, isActive, lastConfirmedPeriod, createdAt, updatedAt, userId, deletedAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Synced');

updateFromRemote:
UPDATE recurring_movements
SET name = ?, type = ?, amount = ?, description = ?, categoryId = ?, accountId = ?, frequency = ?, dayOfMonth = ?, isActive = ?, lastConfirmedPeriod = ?, createdAt = ?, updatedAt = ?, userId = ?, deletedAt = ?, syncState = 'Synced'
WHERE id = ?;

countPending:
SELECT COUNT(*) FROM recurring_movements WHERE syncState = 'Pending' AND userId IS NOT NULL;

countUnclaimed:
SELECT COUNT(*) FROM recurring_movements WHERE userId IS NULL;
