-- Migration 5 → 6: add the loans and loan_payments tables — a ledger parallel to `transactions`
-- that no existing query reads (ADR 010).
--
-- Additive only: nothing that already exists is read, rebuilt or dropped, so there is no data to
-- convert and no row this migration can lose.

CREATE TABLE loans (
    loanId      TEXT NOT NULL PRIMARY KEY,
    personName  TEXT NOT NULL,
    personKey   TEXT NOT NULL,
    principal   INTEGER NOT NULL,
    interestBps INTEGER NOT NULL DEFAULT 0,
    totalDue    INTEGER NOT NULL,
    note        TEXT NOT NULL DEFAULT '',
    lentAt      TEXT NOT NULL,
    createdAt   INTEGER NOT NULL,
    updatedAt   INTEGER NOT NULL,
    userId      TEXT,
    deletedAt   INTEGER,
    syncState   TEXT NOT NULL DEFAULT 'Pending'
);

CREATE INDEX IF NOT EXISTS loans_person_idx ON loans(personKey);
CREATE INDEX IF NOT EXISTS loans_user_deleted_idx ON loans(userId, deletedAt);

CREATE TABLE loan_payments (
    paymentId TEXT NOT NULL PRIMARY KEY,
    loanId    TEXT NOT NULL REFERENCES loans(loanId) ON DELETE RESTRICT,
    amount    INTEGER NOT NULL,
    method    TEXT NOT NULL,
    paidAt    TEXT NOT NULL,
    note      TEXT NOT NULL DEFAULT '',
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    userId    TEXT,
    deletedAt INTEGER,
    syncState TEXT NOT NULL DEFAULT 'Pending'
);

CREATE INDEX IF NOT EXISTS loan_payments_loan_idx ON loan_payments(loanId);
CREATE INDEX IF NOT EXISTS loan_payments_user_deleted_idx ON loan_payments(userId, deletedAt);
