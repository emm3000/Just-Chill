import kotlin.Boolean;

CREATE TABLE categories (
    categoryId    TEXT NOT NULL PRIMARY KEY,
    name          TEXT NOT NULL,
    icon          TEXT NOT NULL,
    color         TEXT NOT NULL,
    categoryType  TEXT NOT NULL,
    isDefault     INTEGER AS Boolean NOT NULL DEFAULT 0,
    updatedAt     INTEGER NOT NULL,
    createdAt     INTEGER NOT NULL,
    userId        TEXT,
    deletedAt     INTEGER,
    syncState     TEXT NOT NULL DEFAULT 'Pending'
);

CREATE INDEX IF NOT EXISTS categories_type_idx ON categories(categoryType);

-- The parent key of the composite foreign key that `transactions` and `recurring_movements`
-- declare on (categoryId, type). SQLite REQUIRES the parent columns of a composite FK to be
-- covered by a UNIQUE index or a PK: without this index the child DDL parses fine and then every
-- INSERT fails at runtime with "foreign key mismatch". `categoryId` alone being the PK does not
-- satisfy it, and `categories_type_idx` is neither unique nor on both columns.
--
-- It is redundant as a uniqueness claim — categoryId is already the primary key, so no two rows
-- can share it whatever their type — and that is fine: it exists to be the index SQLite looks up,
-- not to constrain anything new.
CREATE UNIQUE INDEX IF NOT EXISTS categories_id_type_uidx ON categories(categoryId, categoryType);
CREATE INDEX IF NOT EXISTS categories_syncstate_idx ON categories(syncState);
CREATE INDEX IF NOT EXISTS categories_user_deleted_idx ON categories(userId, deletedAt);

all:
SELECT * FROM categories WHERE deletedAt IS NULL;

insert:
INSERT OR REPLACE INTO categories(categoryId, name, icon, color, categoryType, isDefault, updatedAt, createdAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'Pending');

softDelete:
UPDATE categories
SET deletedAt = ?, updatedAt = ?, syncState = 'Pending'
WHERE categoryId = ?;

-- Backup restore — see the equivalent block in accounts.sq for why this is a tombstone plus
-- INSERT OR IGNORE + UPDATE rather than a DELETE plus INSERT OR REPLACE. For categories the
-- OR REPLACE variant is worse still: the physical delete fires ON DELETE SET NULL and silently
-- strips the category off every transaction that referenced it.
softDeleteAllLive:
UPDATE categories
SET deletedAt = :deletedAt, updatedAt = :updatedAt, syncState = 'Pending'
WHERE deletedAt IS NULL;

insertOrIgnoreFromBackup:
INSERT OR IGNORE INTO categories(categoryId, name, icon, color, categoryType, isDefault, updatedAt, createdAt, syncState)
VALUES (?, ?, ?, ?, ?, 0, ?, ?, 'Pending');

restoreFromBackup:
UPDATE categories
SET name = ?, icon = ?, color = ?, categoryType = ?, isDefault = 0, updatedAt = ?, deletedAt = NULL, syncState = 'Pending'
WHERE categoryId = ?;

find:
SELECT * FROM categories WHERE categoryId = ? AND deletedAt IS NULL;

countDefaultCategories:
SELECT COUNT(*) FROM categories WHERE isDefault = 1 AND deletedAt IS NULL;

updateValues:
UPDATE categories
SET name = ?, updatedAt = ?, syncState = 'Pending'
WHERE categoryId = ?;

claimAll:
UPDATE categories SET userId = :userId, syncState = 'Pending' WHERE userId IS NULL;

unclaimAll:
UPDATE categories SET userId = NULL, syncState = 'Pending' WHERE userId = :userId;

selectPending:
SELECT * FROM categories WHERE syncState = 'Pending' AND userId IS NOT NULL;

markSynced:
UPDATE categories SET syncState = 'Synced' WHERE categoryId = ? AND updatedAt = ?;

markPendingForResync:
UPDATE categories SET syncState = 'Pending' WHERE categoryId = ?;

-- See accounts.sq:accountSyncRevision for why syncState is selected and why the name is per-table.
categorySyncRevision:
SELECT updatedAt, syncState FROM categories WHERE categoryId = ?;

insertOrIgnoreFromRemote:
INSERT OR IGNORE INTO categories(categoryId, name, icon, color, categoryType, isDefault, updatedAt, createdAt, userId, deletedAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Synced');

updateFromRemote:
UPDATE categories
SET name = ?, icon = ?, color = ?, categoryType = ?, isDefault = ?, updatedAt = ?, createdAt = ?, userId = ?, deletedAt = ?, syncState = 'Synced'
WHERE categoryId = ?;

countPending:
SELECT COUNT(*) FROM categories WHERE syncState = 'Pending' AND userId IS NOT NULL;

countUnclaimed:
SELECT COUNT(*) FROM categories WHERE userId IS NULL;
