CREATE TABLE transactions (
    transactionId  TEXT NOT NULL PRIMARY KEY,
    type           TEXT NOT NULL,
    amount         INTEGER NOT NULL,
    description    TEXT NOT NULL DEFAULT '',
    date           INTEGER NOT NULL,
    categoryId     TEXT REFERENCES categories(categoryId) ON DELETE SET NULL,
    accountId      TEXT NOT NULL REFERENCES accounts(accountId) ON DELETE RESTRICT,
    createdAt      INTEGER NOT NULL,
    updatedAt      INTEGER NOT NULL,
    userId         TEXT,
    deletedAt      INTEGER,
    syncState      TEXT NOT NULL DEFAULT 'Pending'
);

CREATE INDEX IF NOT EXISTS transactions_account_idx  ON transactions(accountId);
CREATE INDEX IF NOT EXISTS transactions_date_idx     ON transactions(date);
CREATE INDEX IF NOT EXISTS transactions_category_idx ON transactions(categoryId);
CREATE INDEX IF NOT EXISTS transactions_syncstate_idx ON transactions(syncState);
CREATE INDEX IF NOT EXISTS transactions_user_deleted_idx ON transactions(userId, deletedAt);

all:
SELECT * FROM transactions WHERE deletedAt IS NULL ORDER BY date DESC;

completeTransactions:
SELECT
    t.*,
    c.name AS categoryName,
    c.icon AS categoryIcon,
    c.color AS categoryColor,
    c.categoryType AS categoryType_
FROM transactions t
LEFT JOIN categories c ON t.categoryId = c.categoryId AND c.deletedAt IS NULL
WHERE t.deletedAt IS NULL
ORDER BY t.date DESC;

completeTransactionsByDateRange:
SELECT
    t.*,
    c.name AS categoryName,
    c.icon AS categoryIcon,
    c.color AS categoryColor,
    c.categoryType AS categoryType_
FROM transactions t
LEFT JOIN categories c ON t.categoryId = c.categoryId AND c.deletedAt IS NULL
WHERE t.deletedAt IS NULL
  AND t.date >= :startOfMonth
  AND t.date < :startOfNextMonth
ORDER BY t.date DESC;

-- Unknown type values (e.g. from a newer app version on another device) contribute 0,
-- consistent with the mapper skip-row policy: a row the app cannot interpret is invisible
-- everywhere rather than partially visible (misclassified as a spend).
getAccountBalance:
SELECT COALESCE(
    SUM(CASE WHEN type = 'Income' THEN amount WHEN type = 'Spend' THEN -amount ELSE 0 END), 0
)
FROM transactions
WHERE accountId = :accountId AND deletedAt IS NULL;

insert:
INSERT OR REPLACE INTO transactions(transactionId, type, amount, description, date, categoryId, accountId, createdAt, updatedAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'Pending');

find:
SELECT * FROM transactions WHERE transactionId = ? AND deletedAt IS NULL;

update:
UPDATE transactions
SET type = ?, amount = ?, description = ?, date = ?, accountId = ?, categoryId = ?, updatedAt = ?, syncState = 'Pending'
WHERE transactionId = ?;

countByAccount:
SELECT COUNT(*) FROM transactions WHERE accountId = :accountId;

countLiveByAccount:
SELECT COUNT(*) FROM transactions WHERE accountId = :accountId AND deletedAt IS NULL;

nullCategoryOnLiveRows:
UPDATE transactions
SET categoryId = NULL, updatedAt = :updatedAt, syncState = 'Pending'
WHERE categoryId = :categoryId AND deletedAt IS NULL;

searchTransactions:
SELECT
    t.*,
    c.name AS categoryName,
    c.icon AS categoryIcon,
    c.color AS categoryColor,
    c.categoryType AS categoryType_
FROM transactions t
LEFT JOIN categories c ON t.categoryId = c.categoryId AND c.deletedAt IS NULL
WHERE t.deletedAt IS NULL
  AND (:queryEmpty = 1 OR LOWER(t.description) LIKE '%' || LOWER(:query) || '%')
  AND (:categoryFilterEmpty = 1 OR t.categoryId IN :categoryIds)
ORDER BY t.date DESC;

softDelete:
UPDATE transactions
SET deletedAt = ?, updatedAt = ?, syncState = 'Pending'
WHERE transactionId = ?;

deleteAll:
DELETE FROM transactions;

monthlyStats:
SELECT COUNT(*) AS movementCount, COALESCE(SUM(amount), 0) AS totalAmount
FROM transactions
WHERE type = :type
  AND date >= :startInclusive
  AND date < :endExclusive
  AND deletedAt IS NULL;

monthlyAmountByCategory:
SELECT
    c.categoryId AS categoryId,
    c.name       AS categoryName,
    c.icon       AS categoryIcon,
    c.color      AS categoryColor,
    SUM(t.amount) AS totalAmount
FROM transactions t
INNER JOIN categories c ON t.categoryId = c.categoryId AND c.deletedAt IS NULL
WHERE t.type = :type
  AND t.date >= :startInclusive
  AND t.date < :endExclusive
  AND t.deletedAt IS NULL
GROUP BY c.categoryId
ORDER BY totalAmount DESC;

topUsedCategoryIds:
SELECT categoryId
FROM transactions
WHERE categoryId IS NOT NULL
  AND type = :type
  AND date >= :startInclusive
  AND deletedAt IS NULL
GROUP BY categoryId
ORDER BY COUNT(*) DESC, MAX(date) DESC
LIMIT :limit;

topUsedCombos:
SELECT accountId, categoryId, type
FROM transactions
WHERE categoryId IS NOT NULL
  AND type = :type
  AND date >= :startInclusive
  AND deletedAt IS NULL
GROUP BY accountId, categoryId, type
ORDER BY COUNT(*) DESC, MAX(date) DESC
LIMIT :limit;

lastUsedAccountId:
SELECT accountId
FROM transactions
WHERE deletedAt IS NULL
ORDER BY date DESC, createdAt DESC
LIMIT 1;

claimAll:
UPDATE transactions SET userId = :userId, syncState = 'Pending' WHERE userId IS NULL;

unclaimAll:
UPDATE transactions SET userId = NULL, syncState = 'Pending' WHERE userId = :userId;

selectPending:
SELECT * FROM transactions WHERE syncState = 'Pending' AND userId IS NOT NULL;

markSynced:
UPDATE transactions SET syncState = 'Synced' WHERE transactionId = ? AND updatedAt = ?;

markPendingForResync:
UPDATE transactions SET syncState = 'Pending' WHERE transactionId = ?;

findForSync:
SELECT updatedAt FROM transactions WHERE transactionId = ?;

insertOrIgnoreFromRemote:
INSERT OR IGNORE INTO transactions(transactionId, type, amount, description, date, categoryId, accountId, createdAt, updatedAt, userId, deletedAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Synced');

updateFromRemote:
UPDATE transactions
SET type = ?, amount = ?, description = ?, date = ?, categoryId = ?, accountId = ?, createdAt = ?, updatedAt = ?, userId = ?, deletedAt = ?, syncState = 'Synced'
WHERE transactionId = ?;

countPending:
SELECT COUNT(*) FROM transactions WHERE syncState = 'Pending' AND userId IS NOT NULL;

countUnclaimed:
SELECT COUNT(*) FROM transactions WHERE userId IS NULL;
