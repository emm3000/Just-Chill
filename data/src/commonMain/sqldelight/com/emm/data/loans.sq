-- `totalDue` is written by the domain on every write path and never recomputed in SQL. It is
-- redundant with `principal` and `interestBps` on purpose: the per-person rollup reads it, and
-- rounding the same interest in both Kotlin and SQLite would be two implementations of one rule.
--
-- There is deliberately no `status` column. A loan is settled when its payments cover `totalDue`;
-- a stored status desyncs from the payments that decide it.
CREATE TABLE loans (
    loanId      TEXT NOT NULL PRIMARY KEY,
    personName  TEXT NOT NULL,
    personKey   TEXT NOT NULL,
    principal   INTEGER NOT NULL,
    interestBps INTEGER NOT NULL DEFAULT 0,
    totalDue    INTEGER NOT NULL,
    note        TEXT NOT NULL DEFAULT '',
    -- `lentAt` is ISO local date-time text with no offset, like `transactions.occurredAt` — not epoch millis.
    lentAt      TEXT NOT NULL,
    createdAt   INTEGER NOT NULL,
    updatedAt   INTEGER NOT NULL,
    userId      TEXT,
    deletedAt   INTEGER,
    syncState   TEXT NOT NULL DEFAULT 'Pending'
);

CREATE INDEX IF NOT EXISTS loans_person_idx ON loans(personKey);
CREATE INDEX IF NOT EXISTS loans_user_deleted_idx ON loans(userId, deletedAt);

byId:
SELECT * FROM loans WHERE loanId = ? AND deletedAt IS NULL;

byPerson:
SELECT * FROM loans WHERE personKey = ? AND deletedAt IS NULL ORDER BY lentAt DESC;

insert:
INSERT INTO loans(loanId, personName, personKey, principal, interestBps, totalDue, note, lentAt, createdAt, updatedAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Pending');

updateValues:
UPDATE loans
SET personName = ?, personKey = ?, principal = ?, interestBps = ?, totalDue = ?, note = ?, lentAt = ?, updatedAt = ?, syncState = 'Pending'
WHERE loanId = ?;

softDelete:
UPDATE loans SET deletedAt = ?, updatedAt = ?, syncState = 'Pending' WHERE loanId = ?;

-- SQLite guarantees that a bare column in an aggregate query takes its value from the row holding
-- the min()/max() extremum, but only when the query has exactly one min()/max() aggregate (verified
-- in sqlite3 3.51: adding a second one, e.g. MIN(l.createdAt), flips `personName` to the wrong row
-- while MAX keeps returning the right value). This query has exactly one, MAX(l.lentAt), which is
-- why `personName` here is the name from this person's most recent loan — it matters because
-- several spellings can fold to one `personKey`. That is also why `lastLentAt` is selected: it is
-- what drives the guarantee, even though nothing reads the column itself. The pick is undefined
-- when two loans for one person share the same `lentAt` (reachable: a date picker writing
-- `T00:00:00`, two loans to the same person on one day) — the consequence is cosmetic, which
-- spelling of the name is displayed, never which amount.
balancesByPerson:
SELECT
    l.personKey AS personKey,
    l.personName AS personName,
    MAX(l.lentAt) AS lastLentAt,
    CAST(COALESCE(SUM(l.totalDue), 0) AS INTEGER) AS totalDue,
    CAST(COALESCE(SUM(paid.paidSoFar), 0) AS INTEGER) AS paidSoFar
FROM loans l
LEFT JOIN (
    SELECT loanId, SUM(amount) AS paidSoFar
    FROM loan_payments
    WHERE deletedAt IS NULL
    GROUP BY loanId
) paid ON paid.loanId = l.loanId
WHERE l.deletedAt IS NULL
GROUP BY l.personKey
ORDER BY (SUM(l.totalDue) - COALESCE(SUM(paid.paidSoFar), 0)) DESC, l.personName;
