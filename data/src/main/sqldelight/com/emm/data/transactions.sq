import kotlin.Boolean;

CREATE TABLE transactions (
    transactionId TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    amount REAL NOT NULL,
    description TEXT NOT NULL,
    date INTEGER NOT NULL,
    categoryId TEXT,
    accountId TEXT NOT NULL,
    syncState TEXT NOT NULL, -- PENDING | SYNCED | ERROR
    isDeleted INTEGER AS Boolean NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS transactions_deleted_index ON transactions(isDeleted);

all:
SELECT * FROM transactions WHERE isDeleted = 0 ORDER BY date DESC;

insert:
INSERT OR REPLACE INTO transactions VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

find:
SELECT * FROM transactions WHERE transactionId = ?;

delete:
DELETE FROM transactions WHERE transactionId = ?;

softDelete:
UPDATE transactions
SET
    isDeleted = 1
WHERE
    transactionId = ?;

update:
UPDATE transactions
SET
    type = ?,
    amount = ?,
    description = ?,
    date = ?,
    accountId = ?,
    syncState = ?,
    updatedAt = ?
WHERE
    transactionId = ?;

markAsSync:
UPDATE transactions
SET
    syncState = ?
WHERE
    transactionId = ?;

selectByStatus:
SELECT * FROM transactions WHERE syncState = ?;