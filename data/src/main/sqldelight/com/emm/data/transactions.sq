import kotlin.Boolean;

CREATE TABLE transactions (
    transactionId TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    amount REAL NOT NULL,
    description TEXT NOT NULL,
    date INTEGER NOT NULL,
    categoryId TEXT,
    accountId TEXT NOT NULL,
    synced INTEGER AS Boolean NOT NULL,
    deleted INTEGER AS Boolean NOT NULL,
    updatedAt INTEGER NOT NULL,
    FOREIGN KEY (categoryId) REFERENCES categories(categoryId) ON DELETE SET NULL,
    FOREIGN KEY (accountId) REFERENCES accounts(accountId) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS transactions_deleted_index ON transactions(deleted);

all:
SELECT * FROM transactions WHERE deleted = 0 ORDER BY date DESC;

insert:
INSERT OR REPLACE INTO transactions VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

find:
SELECT * FROM transactions WHERE transactionId = ?;

delete:
DELETE FROM transactions WHERE transactionId = ?;

softDelete:
UPDATE transactions
SET
    deleted = 1
WHERE
    transactionId = ?;


update:
UPDATE transactions
SET
    type = ?,
    amount = ?,
    description = ?,
    date = ?,
    accountId = ?,
    synced = ?,
    updatedAt = ?
WHERE
    transactionId = ?;

selectByStatus:
SELECT * FROM transactions WHERE synced = ?;