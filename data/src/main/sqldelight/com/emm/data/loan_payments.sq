-- `ON DELETE RESTRICT` guards a physical delete no code path performs: this repo soft-deletes, and
-- an ON DELETE clause only acts on a real DELETE. What has to happen instead is an obligation on
-- `LoanRepository.delete`, stated there.
CREATE TABLE loan_payments (
    paymentId TEXT NOT NULL PRIMARY KEY,
    loanId    TEXT NOT NULL REFERENCES loans(loanId) ON DELETE RESTRICT,
    amount    INTEGER NOT NULL,
    method    TEXT NOT NULL,
    paidAt    TEXT NOT NULL,
    note      TEXT NOT NULL DEFAULT '',
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    userId    TEXT,
    deletedAt INTEGER,
    syncState TEXT NOT NULL DEFAULT 'Pending'
);

CREATE INDEX IF NOT EXISTS loan_payments_loan_idx ON loan_payments(loanId);
CREATE INDEX IF NOT EXISTS loan_payments_user_deleted_idx ON loan_payments(userId, deletedAt);

byId:
SELECT * FROM loan_payments WHERE paymentId = ? AND deletedAt IS NULL;

byLoan:
SELECT * FROM loan_payments WHERE loanId = ? AND deletedAt IS NULL ORDER BY paidAt DESC;

insert:
INSERT INTO loan_payments(paymentId, loanId, amount, method, paidAt, note, createdAt, updatedAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'Pending');

update:
UPDATE loan_payments SET amount = ?, method = ?, paidAt = ?, note = ?, updatedAt = ?, syncState = 'Pending'
WHERE paymentId = ? AND deletedAt IS NULL;

softDelete:
UPDATE loan_payments SET deletedAt = ?, updatedAt = ?, syncState = 'Pending' WHERE paymentId = ?;

paidSoFar:
SELECT COALESCE(SUM(amount), 0) FROM loan_payments WHERE loanId = ? AND deletedAt IS NULL;

softDeleteByLoan:
UPDATE loan_payments SET deletedAt = ?, updatedAt = ?, syncState = 'Pending'
WHERE loanId = ? AND deletedAt IS NULL;

all:
SELECT * FROM loan_payments WHERE deletedAt IS NULL;

-- Backup restore — see the equivalent block in accounts.sq for the shape. A payment can only be
-- inserted after its loan exists, so the restore writes `loans` before this table.
softDeleteAllLive:
UPDATE loan_payments
SET deletedAt = :deletedAt, updatedAt = :updatedAt, syncState = 'Pending'
WHERE deletedAt IS NULL;

insertOrIgnoreFromBackup:
INSERT OR IGNORE INTO loan_payments(paymentId, loanId, amount, method, paidAt, note, createdAt, updatedAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'Pending');

restoreFromBackup:
UPDATE loan_payments
SET loanId = ?, amount = ?, method = ?, paidAt = ?, note = ?, updatedAt = ?, deletedAt = NULL, syncState = 'Pending'
WHERE paymentId = ?;
