import kotlin.Boolean;

CREATE TABLE categories (
    categoryId TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    icon TEXT NOT NULL,
    color TEXT NOT NULL,
    categoryType TEXT NOT NULL,
    syncState TEXT NOT NULL, -- PENDING | SYNCED | ERROR
    isDefault INTEGER AS Boolean NOT NULL,
    isDeleted INTEGER AS Boolean NOT NULL,
    updatedAt INTEGER NOT NULL,
    createdAt INTEGER NOT NULL
);

all:
SELECT * FROM categories;

insert:
INSERT OR REPLACE INTO categories VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM categories WHERE categoryId = ?;

find:
SELECT * FROM categories WHERE categoryId = ?;

countDefaultCategories:
SELECT COUNT(*) FROM categories WHERE isDefault = 1;

updateValues:
UPDATE categories
SET
    name = ?,
    syncState = ?,
    updatedAt = ?
WHERE
    categoryId = ?;

selectByStatus:
SELECT * FROM categories WHERE syncState = ?;