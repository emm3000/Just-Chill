import kotlin.Boolean;

CREATE TABLE categories (
    categoryId    TEXT NOT NULL PRIMARY KEY,
    name          TEXT NOT NULL,
    icon          TEXT NOT NULL,
    color         TEXT NOT NULL,
    categoryType  TEXT NOT NULL,
    isDefault     INTEGER AS Boolean NOT NULL DEFAULT 0,
    updatedAt     INTEGER NOT NULL,
    createdAt     INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS categories_type_idx ON categories(categoryType);

all:
SELECT * FROM categories;

insert:
INSERT OR REPLACE INTO categories(categoryId, name, icon, color, categoryType, isDefault, updatedAt, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM categories WHERE categoryId = ?;

deleteAll:
DELETE FROM categories;

find:
SELECT * FROM categories WHERE categoryId = ?;

countDefaultCategories:
SELECT COUNT(*) FROM categories WHERE isDefault = 1;

updateValues:
UPDATE categories
SET name = ?, updatedAt = ?
WHERE categoryId = ?;
