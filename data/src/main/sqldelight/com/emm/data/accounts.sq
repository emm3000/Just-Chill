CREATE TABLE accounts (
    accountId  TEXT NOT NULL PRIMARY KEY,
    name       TEXT NOT NULL,
    type       TEXT NOT NULL DEFAULT 'Bank',
    currency   TEXT NOT NULL DEFAULT 'PEN',
    updatedAt  INTEGER NOT NULL,
    createdAt  INTEGER NOT NULL,
    userId     TEXT,
    deletedAt  INTEGER,
    syncState  TEXT NOT NULL DEFAULT 'Pending'
);

CREATE INDEX IF NOT EXISTS accounts_syncstate_idx ON accounts(syncState);
CREATE INDEX IF NOT EXISTS accounts_user_deleted_idx ON accounts(userId, deletedAt);

all:
SELECT * FROM accounts WHERE deletedAt IS NULL;

insert:
INSERT OR REPLACE INTO accounts(accountId, name, type, currency, updatedAt, createdAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, 'Pending');

find:
SELECT * FROM accounts WHERE accountId = ? AND deletedAt IS NULL;

softDelete:
UPDATE accounts
SET deletedAt = ?, updatedAt = ?, syncState = 'Pending'
WHERE accountId = ?;

deleteAll:
DELETE FROM accounts;

update:
UPDATE accounts
SET name = ?, type = ?, updatedAt = ?, syncState = 'Pending'
WHERE accountId = ?;

claimAll:
UPDATE accounts SET userId = :userId, syncState = 'Pending' WHERE userId IS NULL;

selectPending:
SELECT * FROM accounts WHERE syncState = 'Pending' AND userId IS NOT NULL;

markSynced:
UPDATE accounts SET syncState = 'Synced' WHERE accountId = ? AND updatedAt = ?;

markPendingForResync:
UPDATE accounts SET syncState = 'Pending' WHERE accountId = ?;

findForSync:
SELECT updatedAt FROM accounts WHERE accountId = ?;

insertOrIgnoreFromRemote:
INSERT OR IGNORE INTO accounts(accountId, name, type, currency, updatedAt, createdAt, userId, deletedAt, syncState)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'Synced');

updateFromRemote:
UPDATE accounts
SET name = ?, type = ?, currency = ?, updatedAt = ?, createdAt = ?, userId = ?, deletedAt = ?, syncState = 'Synced'
WHERE accountId = ?;

countPending:
SELECT COUNT(*) FROM accounts WHERE syncState = 'Pending' AND userId IS NOT NULL;

countUnclaimed:
SELECT COUNT(*) FROM accounts WHERE userId IS NULL;
