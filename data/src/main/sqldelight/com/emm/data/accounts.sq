import kotlin.Boolean;

CREATE TABLE accounts (
    accountId  TEXT NOT NULL PRIMARY KEY,
    name       TEXT NOT NULL,
    syncState  TEXT NOT NULL, -- PENDING | SYNCED | ERROR
    isDeleted  INTEGER AS Boolean NOT NULL DEFAULT 0,
    updatedAt  INTEGER NOT NULL,
    createdAt  INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS accounts_sync_idx ON accounts(syncState, isDeleted);

all:
SELECT * FROM accounts WHERE isDeleted = 0;

insert:
INSERT OR REPLACE INTO accounts(accountId, name, syncState, isDeleted, updatedAt, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

find:
SELECT * FROM accounts WHERE accountId = ? AND isDeleted = 0;

softDelete:
UPDATE accounts SET isDeleted = 1, updatedAt = ? WHERE accountId = ?;

update:
UPDATE accounts
SET name = ?, syncState = ?, updatedAt = ?
WHERE accountId = ?;

markAsSync:
UPDATE accounts SET syncState = ? WHERE accountId = ?;

selectByStatus:
SELECT * FROM accounts WHERE syncState = ? AND isDeleted = 0;

selectPendingSync:
SELECT * FROM accounts
WHERE syncState = 'PENDING' OR isDeleted = 1
ORDER BY updatedAt ASC;
