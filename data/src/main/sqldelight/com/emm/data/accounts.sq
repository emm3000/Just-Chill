CREATE TABLE accounts (
    accountId TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    balance REAL NOT NULL,
    description TEXT,
    defaultSelection INTEGER NOT NULL DEFAULT 0
);

retrieveAll:
SELECT * FROM accounts;

insert:
INSERT OR REPLACE INTO accounts VALUES(?, ?, ?, ?, ?);

delete:
DELETE FROM accounts WHERE accountId = ?;

find:
SELECT * FROM accounts WHERE accountId = ?;

default:
SELECT * FROM accounts WHERE defaultSelection = 1;

defaultAccount:
UPDATE accounts
SET defaultSelection = CASE WHEN accountId = ? THEN 1 ELSE 0 END;

updateValues:
UPDATE accounts
SET
    name = ?,
    balance = ?,
    description = ?
WHERE
    accountId = ?;

updateBalance:
UPDATE accounts
SET
    balance = ?
WHERE
    accountId = ?;