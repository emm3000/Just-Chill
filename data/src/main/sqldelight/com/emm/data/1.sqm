-- Migration 1 → 2: add recurring_movements table.
-- onUpgrade in Providers.kt performs destructive migration for alpha builds,
-- so this file exists solely to bump the schema version so SQLite detects the
-- change and fires onUpgrade for existing dev installs.

CREATE TABLE IF NOT EXISTS recurring_movements (
    id                  TEXT NOT NULL PRIMARY KEY,
    name                TEXT NOT NULL,
    type                TEXT NOT NULL,
    amount              INTEGER,
    description         TEXT NOT NULL DEFAULT '',
    categoryId          TEXT REFERENCES categories(categoryId) ON DELETE SET NULL,
    accountId           TEXT NOT NULL REFERENCES accounts(accountId) ON DELETE RESTRICT,
    frequency           TEXT NOT NULL DEFAULT 'Monthly',
    dayOfMonth          INTEGER NOT NULL,
    isActive            INTEGER NOT NULL DEFAULT 1,
    lastConfirmedPeriod TEXT,
    createdAt           INTEGER NOT NULL,
    updatedAt           INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS recurring_active_idx ON recurring_movements(isActive, name);
